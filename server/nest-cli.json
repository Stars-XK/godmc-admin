{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/api-gateway/src",
  "monorepo": true,
  "root": "apps/api-gateway",
  "compilerOptions": {
    "webpack": true,
    "tsConfigPath": "tsconfig.build.json",
    "assets": [
      "**/*.yml"
    ],
    "watchAssets": true,
    "deleteOutDir": true
  },
  "projects": {
    "api-gateway": {
      "type": "application",
      "root": "apps/api-gateway",
      "entryFile": "main",
      "sourceRoot": "apps/api-gateway/src",
      "compilerOptions": {
        "tsConfigPath": "tsconfig.build.json"
      }
    },
    "micro-auth": {
      "type": "application",
      "root": "apps/micro-auth",
      "entryFile": "main",
      "sourceRoot": "apps/micro-auth/src",
      "compilerOptions": {
        "tsConfigPath": "apps/micro-auth/tsconfig.app.json"
      }
    },
    "micro-system": {
      "type": "application",
      "root": "apps/micro-system",
      "entryFile": "main",
      "sourceRoot": "apps/micro-system/src",
      "compilerOptions": {
        "tsConfigPath": "apps/micro-system/tsconfig.app.json"
      }
    },
    "micro-monitor": {
      "type": "application",
      "root": "apps/micro-monitor",
      "entryFile": "main",
      "sourceRoot": "apps/micro-monitor/src",
      "compilerOptions": {
        "tsConfigPath": "apps/micro-monitor/tsconfig.app.json"
      }
    }
  }
}